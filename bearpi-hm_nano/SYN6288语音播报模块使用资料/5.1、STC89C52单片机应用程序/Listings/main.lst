  31          //串口1初始化
  32          void UART1_Init(void)
  33          {
  34   1              SCON = 0x50;            //8位数据,可变波特率
  35   1              TMOD |= 0x20;           //设定定时器1为8位自动重装方式
  36   1              TL1 = 0xFD;             //设定定时初值
  37   1              TH1 = 0xFD;             //设定定时器重装值
  38   1              ET1 = 0;                //禁止定时器1中断
  39   1              TR1 = 1;                //启动定时器1
  40   1              ES = 1;
  41   1              EA = 1;
  42   1      }
  43          
  44          //串口2发送一字节数据
  45          void UART1_SendByte(uchar DAT)
  46          {
  47   1              SBUF = DAT;
  48   1              while(TI == 0);
  49   1              TI=0;
  50   1      }
  51          
  52          //串口2发送字符串数据
  53          void UART1_SendString(uchar *DAT, uchar len)
  54          {
C51 COMPILER V9.00   MAIN                                                                  04/25/2020 20:37:01 PAGE 2   

  55   1              uchar i;
  56   1              for(i = 0; i < len; i++)
  57   1              {
  58   2                      UART1_SendByte(*DAT++);
  59   2              }
  60   1      }
  61          
