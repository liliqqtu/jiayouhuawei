  72          
  73          //Music:  0:无背景音乐  1~15:选择背景音乐
  74          void SYN_FrameInfo(uchar Music, uchar *HZdata)
  75          {
  76   1              /****************需要发送的文本**********************************/
  77   1              uchar  Frame_Info[50];
  78   1              uchar  HZ_Length;
  79   1              uchar  ecc  = 0;                        //定义校验字节
  80   1              uint i = 0;
  81   1              HZ_Length = strlen((char*)HZdata);                      //需要发送文本的长度
  82   1      
  83   1              /*****************帧固定配置信息**************************************/
  84   1              Frame_Info[0] = 0xFD ;                  //构造帧头FD
  85   1              Frame_Info[1] = 0x00 ;                  //构造数据区长度的高字节
  86   1              Frame_Info[2] = HZ_Length + 3;          //构造数据区长度的低字节
  87   1              Frame_Info[3] = 0x01 ;                  //构造命令字：合成播放命令
  88   1              Frame_Info[4] = 0x01 | Music << 4 ; //构造命令参数：背景音乐设定
  89   1      
  90   1              /*******************校验码计算***************************************/
  91   1              for(i = 0; i < 5; i++)                                  //依次发送构造好的5个帧头字节
  92   1              {
  93   2                      ecc = ecc ^ (Frame_Info[i]);            //对发送的字节进行异或校验
  94   2              }
  95   1      
  96   1              for(i = 0; i < HZ_Length; i++)                  //依次发送待合成的文本数据
  97   1              {
  98   2                      ecc = ecc ^ (HZdata[i]);                                //对发送的字节进行异或校验
  99   2              }
 100   1              /*******************发送帧信息***************************************/
 101   1              memcpy(&Frame_Info[5], HZdata, HZ_Length);
 102   1              Frame_Info[5 + HZ_Length] = ecc;
 103   1              UART1_SendString(Frame_Info, 5 + HZ_Length + 1);
 104   1      }
