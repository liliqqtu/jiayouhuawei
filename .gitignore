# ==========================================
# GitHub 大文件排除规则 (GitHub 限制单文件不能超过 100MB)
# ==========================================
*.zip
*.7z
*.rar
DevTools_Hi3861V100_v1.0.zip

# ==========================================
# 硬件编译中间产物 (源码保留，中间目标文件与库排除)
# ==========================================
**/out/
*.o
*.a
*.d
*.ninja
*.ninja_deps
*.ninja_log

# ==========================================
# 鸿蒙 ArkTS 应用构建缓存与依赖库 (可通过 ohpm 自动下载)
# ==========================================
**/node_modules/
**/oh_modules/
**/.hvigor/
**/build/
.cxx/
/.clangd/
/.clang-format/
/.clang-tidy/
**/.test/
/.appanalyzer/
local.properties

# ==========================================
# IDE 本地工作空间与环境配置
# ==========================================
**/.idea/
**/.deveco/
**/.vscode/
*.suo
*.user
Thumbs.db
[Dd]esktop.ini

# ==========================================
# Python 运行缓存与数据库
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.log
**/data/*.db*
*.db
*.db-shm
*.db-wal
